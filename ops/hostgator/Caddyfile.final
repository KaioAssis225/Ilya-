{
	admin off
}

# Caddyfile FINAL da virada (substitui /opt/ilya-ingress/Caddyfile só no passo 4 do
# RUNBOOK-virada.md). Não é aplicado por nenhum script deste repositório.
#
# Rotas públicas (via rewrites da Vercel, frontend/vercel.json):
#   /api/v1/*  /static/*  /health/live  /health/ready   -> Ilya    127.0.0.1:19080
#   /estoque-api/v1/*  (vira /api/v1/*)                  -> Estoque 127.0.0.1:19082
#   /estoque-health/live|ready                           -> Estoque (monitor externo)
# Todo o resto responde 404.
#
# trusted_proxies: NÃO definido de propósito. O Caddy não confia em nenhum
# X-Forwarded-For recebido e o substitui pelo IP de quem conectou (a Vercel). A
# Vercel não publica faixas de IP fixas; confiar em "tudo" deixaria qualquer um
# forjar o IP do cliente e burlar o rate limit de login. No Railway o efeito era o
# mesmo (o IP efetivo era o da Vercel), então não há regressão. O ensaio prova que
# um X-Forwarded-For forjado não chega às APIs (ver RUNBOOK-virada.md).
https://143.95.189.88 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}

	@ilya path /api/v1/* /static/* /health/live /health/ready
	handle @ilya {
		# Mesmo teto do nginx da homologação (client_max_body_size 15m).
		request_body {
			max_size 15MB
		}
		reverse_proxy 127.0.0.1:19080
	}

	@stock_health path /estoque-health/live /estoque-health/ready
	handle @stock_health {
		uri replace /estoque-health /health
		reverse_proxy 127.0.0.1:19082
	}

	handle /estoque-api/v1/* {
		uri replace /estoque-api/v1/ /api/v1/ 1
		request_body {
			max_size 15MB
		}
		reverse_proxy 127.0.0.1:19082
	}

	handle {
		respond 404
	}
}
